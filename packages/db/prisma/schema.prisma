generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

enum ActivityLogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

enum TenantSubscriptionStatus {
  ACTIVE
  PAST_DUE
}

enum WalletTransactionType {
  TOP_UP
  SUBSCRIPTION_CHARGE
  REFUND
  ADJUSTMENT
}

enum WalletTopUpStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Tenant {
  id                       String                   @id @default(uuid())
  ownerUserId              String                   @unique
  subscriptionId           String?
  subscriptionStatus       TenantSubscriptionStatus @default(ACTIVE)
  subscriptionStartedAt    DateTime?
  subscriptionPeriodStartAt DateTime?
  subscriptionPeriodEndAt  DateTime?
  subscriptionNextBillingAt DateTime?
  slug                     String                   @unique
  publicKey                String                   @unique @default(dbgenerated("substr(replace(gen_random_uuid()::text, '-', ''), 1, 8)"))
  name                     String
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  ownerUser          User          @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  subscription       Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  wallet             Wallet?
  walletTransactions WalletTransaction[]
  walletTopUps       WalletTopUp[]
  campaigns      Campaign[]
  brands         Brand[]
  affiliatePlatforms AffiliatePlatform[]
  datasets            Dataset[]
  campaignDatasets   CampaignDataset[]
  trackingLinks      TrackingLink[]
  clickEvents        ClickEvent[]
  conversionEvents   AffiliateConversionEvent[]
  affiliateRefAttributions AffiliateRefAttribution[]
  capiEvents         CapiEvent[]
  reportSchedules    ReportSchedule[]
  menuGrants         TenantMenuGrant[]
  activityLogs       ActivityLog[]
  websiteDomains     WebsiteDomain[]

  @@index([ownerUserId])
  @@index([subscriptionId])
  @@index([subscriptionNextBillingAt])
  @@index([subscriptionStatus])
  @@index([publicKey])
  @@index([createdAt])
}

model Subscription {
  id                   String   @id @default(uuid())
  slug                 String   @unique
  name                 String
  description          String?
  monthlyPriceCents    Int      @default(0)
  currency             String   @default("USD")
  clickLimit           Int      @default(1000)
  capiEventLimit       Int      @default(1000)
  eapiEventLimit       Int      @default(1000)
  campaignDatasetLimit Int      @default(2)
  isDefault            Boolean  @default(false)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenants              Tenant[]
  walletTransactions   WalletTransaction[]

  @@index([isDefault])
  @@index([isActive])
}

model Wallet {
  id           String   @id @default(uuid())
  tenantId     String   @unique
  currency     String   @default("USD")
  balanceCents Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@index([currency])
}

model WalletTransaction {
  id                String                @id @default(uuid())
  walletId          String
  tenantId          String
  subscriptionId    String?
  type              WalletTransactionType
  amountCents       Int
  balanceAfterCents Int
  currency          String
  description       String
  reference         String?               @unique
  billingPeriodStart DateTime?
  billingPeriodEnd  DateTime?
  createdAt         DateTime              @default(now())

  wallet            Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription      Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  topUp             WalletTopUp?

  @@index([walletId, createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, type, createdAt])
  @@index([subscriptionId, billingPeriodStart])
}

model WalletTopUp {
  id                  String            @id @default(uuid())
  tenantId            String
  amountCents         Int
  currency            String
  paymentMethod       String            @default("bank_transfer")
  paymentProvider     String?
  paymentReference    String?
  providerTransactionId String?         @unique
  providerReferenceCode String?
  paymentReceivedAt   DateTime?
  note                String?
  reference           String            @unique
  status              WalletTopUpStatus @default(PENDING)
  walletTransactionId String?           @unique
  approvedAt          DateTime?
  approvedByUserId    String?
  rejectedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  walletTransaction   WalletTransaction? @relation(fields: [walletTransactionId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([status, createdAt])
}

model PaymentSettings {
  id                   String   @id @default("default")
  sepayAccountNumber   String?
  sepayAccountName     String?
  sepayWebhookApiKey   String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model MenuFeature {
  id          String   @id @default(uuid())
  key         String   @unique
  path        String   @unique
  label       String
  group       String
  icon        String
  badge       String?
  description String?
  sortOrder   Int      @default(0)
  isCore      Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  grants      TenantMenuGrant[]

  @@index([group])
  @@index([isActive])
  @@index([sortOrder])
}

model TenantMenuGrant {
  id            String      @id @default(uuid())
  tenantId      String
  menuFeatureId String
  isEnabled     Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  menuFeature   MenuFeature @relation(fields: [menuFeatureId], references: [id], onDelete: Cascade)

  @@unique([tenantId, menuFeatureId])
  @@index([tenantId])
  @@index([menuFeatureId])
  @@index([isEnabled])
}

model User {
  id           String   @id @default(uuid())
  clerkUserId  String   @unique
  email        String?
  firstName    String?
  lastName     String?
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant?

  @@index([email])
}

model Campaign {
  id            String         @id @default(uuid())
  tenantId      String
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  datasets       CampaignDataset[]
  trackingLinks  TrackingLink[]
  clickEvents    ClickEvent[]

  @@index([tenantId])
  @@unique([tenantId, name])
}

model Brand {
  id                  String            @id @default(uuid())
  tenantId            String
  affiliatePlatformId String
  name                String
  affiliateUrl        String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  affiliatePlatform   AffiliatePlatform @relation(fields: [affiliatePlatformId], references: [id], onDelete: Cascade)
  trackingLinks       TrackingLink[]

  @@index([tenantId])
  @@index([affiliatePlatformId])
}

model AffiliatePlatform {
  id               String                     @id @default(uuid())
  tenantId         String
  name             String
  slug             String
  trackingParamKey String                     @default("subId1")
  webhookMethod    String                     @default("POST")
  webhookToken     String                     @default(uuid())
  eventMapping     Json                       @default("[]")
  defaultEventName String?                    @default("CompleteRegistration")
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  tenant           Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brands           Brand[]
  trackingLinks    TrackingLink[]
  conversionEvents AffiliateConversionEvent[]
  affiliateRefAttributions AffiliateRefAttribution[]

  @@index([tenantId])
  @@unique([tenantId, slug])
  @@unique([tenantId, name])
}

model Dataset {
  id          String     @id @default(uuid())
  tenantId    String
  platform    String
  name        String
  pixelId     String
  accessToken String
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaigns   CampaignDataset[]
  capiEvents  CapiEvent[]

  @@index([tenantId])
  @@index([platform])
  @@index([isActive])
  @@unique([tenantId, name])
  @@unique([tenantId, platform, pixelId])
}

model CampaignDataset {
  id         String   @id @default(uuid())
  tenantId   String
  campaignId String
  datasetId  String
  createdAt  DateTime @default(now())

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  dataset    Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([campaignId])
  @@index([datasetId])
  @@unique([campaignId, datasetId])
}

model TrackingLink {
  id                       String            @id @default(uuid())
  tenantId                 String
  campaignId               String?
  affiliatePlatformId      String
  brandId                  String?
  slug                     String
  affiliateUrl             String
  prelanderEnabled         Boolean           @default(false)
  prelanderTitle           String?
  prelanderHeadline        String?
  prelanderBody            String?
  prelanderCtaText         String            @default("Continue")
  prelanderCtaDelaySeconds Int               @default(2)
  prelanderTheme           String            @default("clean")
  isActive                 Boolean           @default(true)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  tenant                   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign                 Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  affiliatePlatform        AffiliatePlatform @relation(fields: [affiliatePlatformId], references: [id], onDelete: Restrict)
  brand                    Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  clickEvents              ClickEvent[]

  @@index([tenantId])
  @@index([campaignId])
  @@index([affiliatePlatformId])
  @@index([brandId])
  @@index([isActive])
  @@unique([tenantId, slug])
}

model ClickEvent {
  id             BigInt      @id @default(autoincrement())
  tenantId       String
  campaignId     String?
  trackingLinkId String
  clickUuid      String      @unique
  ip             String?
  userAgent      String?
  referrer       String?
  fbp            String?
  fbc            String?
  ttp            String?
  ttclid         String?
  fbclid         String?
  metadata       Json?
  createdAt      DateTime    @default(now())

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign       Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  trackingLink   TrackingLink @relation(fields: [trackingLinkId], references: [id], onDelete: Cascade)
  capiEvents     CapiEvent[]
  conversionEvents AffiliateConversionEvent[]
  affiliateRefAttributions AffiliateRefAttribution[]

  @@index([tenantId, createdAt])
  @@index([campaignId, createdAt])
  @@index([trackingLinkId, createdAt])
}

model AffiliateConversionEvent {
  id                  BigInt            @id @default(autoincrement())
  tenantId            String
  affiliatePlatformId String
  clickEventId        BigInt?
  clickUuid           String?
  idempotencyKey      String?
  requestCount        Int               @default(1)
  lastReceivedAt      DateTime          @default(now())
  eventName           String?
  eventRule           String?
  eventMatchedField   String?
  eventMatchedValue   String?
  customerId          String?
  customerEmail       String?
  affiliateRefId      String?
  affiliateRefSource  String?
  partnerStackCustomerKey String?
  impactRefClickId    String?
  spendAmount         Decimal?          @db.Decimal(18, 6)
  payoutAmount        Decimal?          @db.Decimal(18, 6)
  commissionAmount    Decimal?          @db.Decimal(18, 6)
  currency            String?
  attributionSnapshot Json?
  capiEnrichment      Json?
  rawPayload          Json
  receivedMethod      String
  createdAt           DateTime          @default(now())

  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  affiliatePlatform   AffiliatePlatform @relation(fields: [affiliatePlatformId], references: [id], onDelete: Cascade)
  clickEvent          ClickEvent?        @relation(fields: [clickEventId], references: [id], onDelete: SetNull)

  @@unique([tenantId, affiliatePlatformId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@index([tenantId, affiliatePlatformId, createdAt])
  @@index([tenantId, clickEventId, createdAt])
  @@index([tenantId, eventName, createdAt])
  @@index([tenantId, affiliateRefSource, affiliateRefId, createdAt], map: "AffConv_tenant_ref_src_ref_id_created_idx")
  @@index([tenantId, partnerStackCustomerKey, createdAt], map: "AffConv_tenant_ps_customer_created_idx")
  @@index([tenantId, impactRefClickId, createdAt], map: "AffConv_tenant_impact_ref_created_idx")
  @@index([affiliatePlatformId, createdAt])
  @@index([clickUuid])
  @@index([affiliateRefId], map: "AffConv_affiliateRefId_idx")
  @@index([idempotencyKey])
}

model AffiliateRefAttribution {
  id                    String            @id @default(uuid())
  tenantId              String
  affiliatePlatformId   String
  affiliateRefSource    String
  affiliateRefId        String
  clickEventId          BigInt
  clickUuid             String
  firstSeenAt           DateTime          @default(now())
  lastSeenAt            DateTime          @default(now())
  learnedAt             DateTime          @default(now())
  lastMatchedAt         DateTime?
  learnedFromConversionEventId BigInt?
  metadata              Json?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  affiliatePlatform     AffiliatePlatform @relation(fields: [affiliatePlatformId], references: [id], onDelete: Cascade)
  clickEvent            ClickEvent        @relation(fields: [clickEventId], references: [id], onDelete: Cascade)

  @@unique([tenantId, affiliatePlatformId, affiliateRefSource, affiliateRefId], map: "AffRefAttr_unique_ref")
  @@index([tenantId, affiliatePlatformId, lastSeenAt], map: "AffRefAttr_tenant_platform_seen_idx")
  @@index([tenantId, clickEventId, lastSeenAt], map: "AffRefAttr_tenant_click_seen_idx")
  @@index([clickUuid], map: "AffRefAttr_clickUuid_idx")
  @@index([affiliateRefId], map: "AffRefAttr_refId_idx")
}

model CapiEvent {
  id           BigInt              @id @default(autoincrement())
  tenantId     String
  clickEventId BigInt
  datasetId    String?
  platform     String
  eventName    String
  source       String              @default("click")
  sourceId     String              @default("")
  payload      Json
  status       EventDeliveryStatus @default(PENDING)
  attempts     Int                 @default(0)
  lastError    String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clickEvent   ClickEvent          @relation(fields: [clickEventId], references: [id], onDelete: Cascade)
  dataset      Dataset?            @relation(fields: [datasetId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, platform, eventName, createdAt])
  @@index([datasetId])
  @@index([status, createdAt])
  @@unique([clickEventId, datasetId, eventName, source, sourceId])
}

model WebsiteDomain {
  id        String   @id @default(uuid())
  tenantId  String
  domain    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@unique([domain])
  @@unique([tenantId, domain])
}

model ActivityLog {
  id         BigInt           @id @default(autoincrement())
  tenantId   String
  level      ActivityLogLevel @default(INFO)
  source     String
  eventType  String
  message    String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime         @default(now())

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, eventType, createdAt])
  @@index([tenantId, level, createdAt])
  @@index([tenantId, source, createdAt])
  @@index([tenantId, entityType, entityId])
}

model ReportSchedule {
  id             String   @id @default(uuid())
  tenantId       String
  name           String
  reportType     String   @default("analytics")
  frequency      String   @default("weekly")
  recipientEmail String?
  filters        Json?
  isActive       Boolean  @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([isActive, nextRunAt])
  @@unique([tenantId, name])
}
